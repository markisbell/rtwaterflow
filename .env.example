# rtwaterflow configuration — pydantic-settings, prefix RTWATERFLOW_, all optional
# (defaults shown; see src/rtwaterflow/config.py)

# --- paths ---
#RTWATERFLOW_DATA_DIR=./data
# network loaded at startup: <data_dir>/networks/<id>
#RTWATERFLOW_DEFAULT_NETWORK=tutorial_hillside
#RTWATERFLOW_NETWORK_LIBRARY=./data/network_library.json
#RTWATERFLOW_USER_NETWORKS_DIR=./data/user_networks
#RTWATERFLOW_SCENARIOS_DIR=./data/scenarios
#RTWATERFLOW_RECORDINGS_DIR=./data/recordings

# --- engine ---
# real seconds per simulated minute (0.01 .. n)
#RTWATERFLOW_STEP_INTERVAL_SECONDS=1.0
#RTWATERFLOW_STEPS_PER_DAY=1440
#RTWATERFLOW_AUTOSTART=true
#RTWATERFLOW_HISTORY_SIZE=1440

# --- solver ---
# base iter for retry-ladder tier 1; tiers 2/3 use 3x
#RTWATERFLOW_SOLVER_ITER=100

# --- observability ---
# false = strict mode: ground-truth layer stripped from API/WS/recordings
#RTWATERFLOW_EXPOSE_GROUND_TRUTH=true

# --- server ---
#RTWATERFLOW_HOST=127.0.0.1
# sibling port scheme: backend 8002 / Vite-UI dev 5175, damit rtwaterflow
# parallel zu rtheatflow (8001/5174) und netzsim/rtpowerflow (8000/5173)
# laufen kann
#RTWATERFLOW_PORT=8002
#RTWATERFLOW_LOG_LEVEL=info
#RTWATERFLOW_CORS_ORIGINS=*
#RTWATERFLOW_RECORD=false
